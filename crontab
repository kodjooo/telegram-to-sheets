# Указываем путь к python внутри python:3.11-slim
PATH=/usr/local/bin:/usr/bin:/bin

# Обработка сообщений Telegram каждые 30 минут
*/30 * * * * cd /app && /usr/local/bin/python3 telegram_to_sheets.py >> /app/logs/telegram_to_sheets.log 2>&1

# Срочные уведомления по критичным логам каждые 5 минут, СО СДВИГОМ со слотов :00/:30 (минуты 2,7,...,57), чтобы не стартовать одновременно со сбором (*/30). flock не даёт прогонам накладываться; троттлинг отправки — раз в 30 мин внутри скрипта
2-59/5 * * * * cd /app && /usr/local/bin/python3 alert_watcher.py >> /app/logs/alert_watcher.log 2>&1

# Отправка ежедневного отчета каждый день в 6:19
19 6 * * * cd /app && echo "---- $(date '+\%Y-\%m-\%d \%H:\%M:\%S') unknown_transaction.py ----" >> /app/logs/unknown_tx.log && /usr/local/bin/python3 unknown_transaction.py >> /app/logs/unknown_tx.log 2>&1

# Автономный агент триажа: вердикты + дайджест дня (вместо локальной рутины).
# Идемпотентен: если дайджест за сегодня уже есть — сразу выходит.
5 9 * * * cd /app && echo "---- $(date '+\%Y-\%m-\%d \%H:\%M:\%S') triage_agent.py ----" >> /app/logs/triage_agent.log && /usr/local/bin/python3 triage_agent.py >> /app/logs/triage_agent.log 2>&1

# Отправка ежедневного отчета: 9:30 МСК (утренний триаж на Маке пользователя
# стартует в 9:05 и пишет дайджест во вкладку Digest). Без свежего дайджеста
# скрипт не шлёт ничего и пробует в следующее окно.
30,45 9 * * * cd /app && echo "---- $(date '+\%Y-\%m-\%d \%H:\%M:\%S') send_daily_summary.py ----" >> /app/logs/daily_summary.log && /usr/local/bin/python3 send_daily_summary.py >> /app/logs/daily_summary.log 2>&1
0,30 10 * * * cd /app && echo "---- $(date '+\%Y-\%m-\%d \%H:\%M:\%S') send_daily_summary.py ----" >> /app/logs/daily_summary.log && /usr/local/bin/python3 send_daily_summary.py >> /app/logs/daily_summary.log 2>&1
0 11,12,13,15 * * * cd /app && echo "---- $(date '+\%Y-\%m-\%d \%H:\%M:\%S') send_daily_summary.py ----" >> /app/logs/daily_summary.log && /usr/local/bin/python3 send_daily_summary.py >> /app/logs/daily_summary.log 2>&1

